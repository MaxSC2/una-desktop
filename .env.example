# U.N.A. Desktop Configuration
# Скопируйте этот файл в .env и заполните значения

# Z.ai API ключ (для облачного LLM)
# Получите: https://z.ai/developers
ZAI_API_KEY=

# Опционально: OpenAI API (для GPT-4o, если используете как fallback)
# OPENAI_API_KEY=

# Опционально: Anthropic API (для Claude)
# ANTHROPIC_API_KEY=

# Опционально: Groq API (для Llama 3.3 70B free tier)
# GROQ_API_KEY=

# Опционально: OpenRouter API (для доступа к множеству моделей)
# OPENROUTER_API_KEY=

# Локальный Ollama URL (если установлен)
# OLLAMA_URL=http://localhost:11434
